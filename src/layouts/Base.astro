---
import '../styles/global.css';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

type Lang = 'en' | 'zh';

interface Props {
	lang?: Lang;
	title: string;
	description?: string;
}

const { lang = 'en', title, description = SITE_DESCRIPTION } = Astro.props;
const prefix = lang === 'zh' ? '/zh' : '';
const path = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

const UI = {
	en: {
		nav: [
			{ href: '/', label: 'Home' },
			{ href: '/projects', label: 'Projects' },
			{ href: '/notes', label: 'Notes' },
			{ href: '/about', label: 'About' },
		],
		langLabel: '中文',
		themeAria: 'Switch color theme',
	},
	zh: {
		nav: [
			{ href: '/', label: '首页' },
			{ href: '/projects', label: '项目' },
			{ href: '/notes', label: '笔记' },
			{ href: '/about', label: '关于' },
		],
		langLabel: 'EN',
		themeAria: '切换颜色主题',
	},
}[lang];

// current path relative to this locale's root
const rel = prefix
	? path === prefix || path.startsWith(prefix + '/')
		? path.slice(prefix.length) || '/'
		: path
	: path;

const hrefOf = (h: string) => (h === '/' ? (prefix ? prefix + '/' : '/') : prefix + h);
const isCurrent = (h: string) => (h === '/' ? rel === '/' : rel.startsWith(h));

// link to the same page in the other language
const altHref = lang === 'zh' ? (rel === '/' ? '/' : rel) : rel === '/' ? '/zh/' : '/zh' + rel;
const altLabel = lang === 'zh' ? 'English' : '中文';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(function () {
				var t = null;
				try {
					t = localStorage.getItem('bf-theme');
				} catch (e) {}
				if (t === 'light' || t === 'dark') {
					document.documentElement.dataset.theme = t;
				}
			})();
		</script>
	</head>
	<body>
		<nav class="nav" aria-label="Main">
			<div class="shell nav-inner">
				<a class="brand" href={hrefOf('/')}>{SITE_TITLE}</a>
				<div style="display:flex;align-items:center;gap:24px;">
					<ul class="nav-links">
						{
							UI.nav.map((l) => (
								<li>
									<a href={hrefOf(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
										{l.label}
									</a>
								</li>
							))
						}
					</ul>
					<a
						class="theme-toggle lang-link"
						href={altHref}
						aria-label={altLabel}
						lang={lang === 'zh' ? 'en' : 'zh'}
						hreflang={lang === 'zh' ? 'en' : 'zh'}
					>
						{UI.langLabel}
					</a>
					<button
						class="theme-toggle"
						id="theme-toggle"
						type="button"
						aria-label={UI.themeAria}
						data-lang={lang}
					>
						<span id="theme-toggle-label">Theme</span>
					</button>
				</div>
			</div>
		</nav>

		<slot />

		<footer class="footer">
			<div class="shell footer-inner">
				<span>© {year} {SITE_AUTHOR} · {SITE_TITLE}</span>
				<div class="footer-links">
					<a href="https://github.com/caigahor-netizen">GitHub</a>
					<a href="mailto:caigahor@gmail.com">Email</a>
				</div>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var btn = document.getElementById('theme-toggle');
				var lab = document.getElementById('theme-toggle-label');
				if (!btn || !lab) return;
				function labels() {
					return btn.getAttribute('data-lang') === 'zh'
						? { light: '浅色', dark: '深色' }
						: { light: 'Light', dark: 'Dark' };
				}
				function current() {
					var dt = document.documentElement.dataset.theme;
					if (dt === 'dark' || dt === 'light') return dt;
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				function render() {
					var l = labels();
					lab.textContent = current() === 'dark' ? l.light : l.dark;
				}
				btn.addEventListener('click', function () {
					var next = current() === 'dark' ? 'light' : 'dark';
					document.documentElement.dataset.theme = next;
					try {
						localStorage.setItem('bf-theme', next);
					} catch (e) {}
					render();
				});
				render();
			})();
		</script>
	</body>
</html>
