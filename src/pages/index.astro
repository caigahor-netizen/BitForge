---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { fmtDate } from '../utils/date';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const notes = (await getCollection('notes'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main class="shell">
		<section class="home-hero">
			<p class="kicker">Personal engineering · knowledge base</p>
			<h1>Engineering at the boundary of hardware &amp; software.</h1>
			<p class="lede">
				Digital power, embedded systems, signal processing, Linux and networking —
				built, measured, and documented.
			</p>
			<div class="hero-ctas">
				<a class="link-row" href="/projects"
					>View projects<span class="arr">→</span></a
				>
				<a class="link-row" href="/notes">Read notes<span class="arr">→</span></a>
			</div>
		</section>

		<section class="block">
			<div class="block-head">
				<h2 class="block-title">Projects</h2>
				<a class="link-row" href="/projects"
					>All projects<span class="arr">→</span></a
				>
			</div>
			<div class="rows">
				{
					projects.map((p) => (
						<a class="row" href={`/projects/${p.id}/`}>
							<div>
								<p class="r-title">{p.data.title}</p>
								<p class="r-desc">{p.data.description}</p>
								<p class="r-meta">
									<span class="meta">{p.data.category}</span>
									<span class="meta">{p.data.technologies?.join(' · ')}</span>
									<span class="meta">{fmtDate(p.data.pubDate)}</span>
								</p>
							</div>
							<span class="row-arrow">→</span>
						</a>
					))
				}
			</div>
		</section>

		<section class="block">
			<div class="block-head">
				<h2 class="block-title">Notes</h2>
				<a class="link-row" href="/notes">All notes<span class="arr">→</span></a>
			</div>
			<div class="rows">
				{
					notes.map((n) => (
						<a class="row" href={`/notes/${n.id}/`}>
							<div>
								<p class="r-title">{n.data.title}</p>
								<p class="r-desc">{n.data.description}</p>
								<p class="r-meta">
									<span class="meta">{n.data.category}</span>
									<span class="meta">{fmtDate(n.data.pubDate)}</span>
								</p>
							</div>
							<span class="row-arrow">→</span>
						</a>
					))
				}
			</div>
		</section>
	</main>
</Base>
