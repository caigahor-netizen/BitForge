---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { fmtDate } from '../../../utils/date';

export async function getStaticPaths() {
	const notes = await getCollection('notesZh');
	return notes.map((n) => ({ params: { slug: n.id }, props: n }));
}

type Props = CollectionEntry<'notesZh'>;

const note = Astro.props;
const { Content } = await render(note);
const title = `${note.data.title} — BitForge`;
---

<Base lang="zh" title={title} description={note.data.description}>
	<main class="article-wrap">
		<a class="back-link" href="/zh/notes/">← 笔记</a>

		<header class="article-head">
			<p class="kicker">{note.data.category}</p>
			<h1>{note.data.title}</h1>
			<p class="lede">{note.data.description}</p>
			<div class="article-meta">
				<span class="meta">{fmtDate(note.data.pubDate)}</span>
				{note.data.updatedDate && (
					<span class="meta">更新于 {fmtDate(note.data.updatedDate)}</span>
				)}
			</div>
		</header>

		<div class="prose">
			<Content />
		</div>
	</main>
</Base>
