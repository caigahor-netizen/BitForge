---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { fmtDate } from '../../../utils/date';

const CATEGORY_ORDER = ['数字电源', '嵌入式', '电子', 'DSP', 'Linux', '网络', '软件'];

const all = (await getCollection('notesZh')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const cats = [
	...CATEGORY_ORDER,
	...[...new Set(all.map((n) => n.data.category))].filter(
		(c) => !CATEGORY_ORDER.includes(c),
	),
];
---

<Base lang="zh" title="笔记 — BitForge" description="技术笔记。">
	<main class="shell">
		<section class="page-head">
			<p class="kicker">技术笔记</p>
			<h1>笔记</h1>
			<p class="lede">
				来自实验室与终端的工作笔记——短小、具体、可复现。
			</p>
		</section>

		<div style="margin-bottom:110px;">
			{
				cats.map((cat) => {
					const list = all.filter((n) => n.data.category === cat);
					if (list.length === 0) return null;
					return (
						<div>
							<p
								class="kicker"
								style="margin-top:52px;display:flex;justify-content:space-between;align-items:baseline;gap:16px;"
							>
								<span>{cat}</span>
								<span>{list.length}</span>
							</p>
							<div class="rows">
								{
									list.map((n) => (
										<a class="row" href={`/zh/notes/${n.id}/`}>
											<div>
												<p class="r-title">{n.data.title}</p>
												<p class="r-desc">{n.data.description}</p>
												<p class="r-meta">
													<span class="meta">{fmtDate(n.data.pubDate)}</span>
												</p>
											</div>
											<span class="row-arrow">→</span>
										</a>
									))
								}
							</div>
						</div>
					);
				})
			}
		</div>
	</main>
</Base>
