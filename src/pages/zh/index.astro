---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE } from '../../consts';
import { fmtDate } from '../../utils/date';

const projects = (await getCollection('projectsZh')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const notes = (await getCollection('notesZh'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Base
	lang="zh"
	title={SITE_TITLE}
	description="个人工程 · 知识库 — 硬件、嵌入式软件、数字电源与系统。"
>
	<main class="shell">
		<section class="home-hero">
			<p class="kicker">个人工程 · 知识库</p>
			<h1>在硬件与软件交界处，做工程。</h1>
			<p class="lede">
				数字电源、嵌入式系统、信号处理、Linux 与网络——设计、测量，并记录成文档。
			</p>
			<div class="hero-ctas">
				<a class="link-row" href="/zh/projects/"
					>查看项目<span class="arr">→</span></a
				>
				<a class="link-row" href="/zh/notes/">阅读笔记<span class="arr">→</span></a>
			</div>
		</section>

		<section class="block">
			<div class="block-head">
				<h2 class="block-title">项目</h2>
				<a class="link-row" href="/zh/projects/"
					>全部项目<span class="arr">→</span></a
				>
			</div>
			<div class="rows">
				{
					projects.map((p) => (
						<a class="row" href={`/zh/projects/${p.id}/`}>
							<div>
								<p class="r-title">{p.data.title}</p>
								<p class="r-desc">{p.data.description}</p>
								<p class="r-meta">
									<span class="meta">{p.data.category}</span>
									<span class="meta">{p.data.technologies?.join(' · ')}</span>
									<span class="meta">{fmtDate(p.data.pubDate)}</span>
								</p>
							</div>
							<span class="row-arrow">→</span>
						</a>
					))
				}
			</div>
		</section>

		<section class="block">
			<div class="block-head">
				<h2 class="block-title">笔记</h2>
				<a class="link-row" href="/zh/notes/">全部笔记<span class="arr">→</span></a>
			</div>
			<div class="rows">
				{
					notes.map((n) => (
						<a class="row" href={`/zh/notes/${n.id}/`}>
							<div>
								<p class="r-title">{n.data.title}</p>
								<p class="r-desc">{n.data.description}</p>
								<p class="r-meta">
									<span class="meta">{n.data.category}</span>
									<span class="meta">{fmtDate(n.data.pubDate)}</span>
								</p>
							</div>
							<span class="row-arrow">→</span>
						</a>
					))
				}
			</div>
		</section>
	</main>
</Base>
