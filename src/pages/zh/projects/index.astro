---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { fmtDate } from '../../../utils/date';

const projects = (await getCollection('projectsZh')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base lang="zh" title="项目 — BitForge" description="硬件与固件项目。">
	<main class="shell">
		<section class="page-head">
			<p class="kicker">精选项目</p>
			<h1>项目</h1>
			<p class="lede">
				我设计、搭建并测量的硬件与固件——从电源变换器到嵌入式控制。
			</p>
		</section>

		<div class="rows" style="margin-bottom:96px;">
			{
				projects.map((p) => (
					<a class="row" href={`/zh/projects/${p.id}/`}>
						<div>
							<p class="r-title">{p.data.title}</p>
							<p class="r-desc">{p.data.description}</p>
							<p class="r-meta">
								<span class="meta">{p.data.category}</span>
								<span class="meta">{p.data.technologies?.join(' · ')}</span>
								<span class="meta">{fmtDate(p.data.pubDate)}</span>
							</p>
						</div>
						<span class="row-arrow">→</span>
					</a>
				))
			}
		</div>
	</main>
</Base>
