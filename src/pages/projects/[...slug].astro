---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate } from '../../utils/date';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((p) => ({ params: { slug: p.id }, props: p }));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
const title = `${project.data.title} — BitForge`;
---

<Base title={title} description={project.data.description}>
	<main class="article-wrap">
		<a class="back-link" href="/projects">← Projects</a>

		<header class="article-head">
			<p class="kicker">{project.data.category}</p>
			<h1>{project.data.title}</h1>
			<p class="lede">{project.data.description}</p>
			<div class="article-meta">
				<span class="meta">{project.data.technologies?.join(' · ')}</span>
				<span class="meta">{fmtDate(project.data.pubDate)}</span>
			</div>
		</header>

		<div class="prose">
			<Content />
		</div>
	</main>
</Base>
