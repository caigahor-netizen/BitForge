---
import Base from '../layouts/Base.astro';

const areas = [
	'Digital Power',
	'Embedded Software',
	'STM32 Systems',
	'DSP / Signal Processing',
	'Electronics / PCB',
	'Linux',
	'Networking',
];
---

<Base title="About — BitForge">
	<main class="article-wrap">
		<section class="page-head" style="padding-block-end:clamp(32px,5vh,56px);">
			<p class="kicker">About</p>
			<h1>BitForge</h1>
		</section>

		<div class="prose">
			<p>
				I'm an engineer working across electrical and embedded systems — power
				conversion, microcontrollers, and the firmware that ties them together.
			</p>
			<p>
				This site is my long-term engineering platform: a place to document projects
				with real architecture, waveforms, and measured results, and to keep the
				notes I want to find again.
			</p>

			<h2>Focus areas</h2>
			<ul>
				{areas.map((a) => (
					<li>{a}</li>
				))}
			</ul>

			<h2>Contact</h2>
			<p>
				Find me on <a href="https://github.com/caigahor-netizen">GitHub</a> or email
				me at <a href="mailto:caigahor@gmail.com">caigahor@gmail.com</a>.
			</p>
		</div>
	</main>
</Base>
