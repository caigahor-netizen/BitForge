---
interface Props { variant?: string; }
const { variant = 'hero' } = Astro.props;
const drone = variant === 'quadcopter';
const power = variant === 'digital-power-supply';
---
<div class:list={['engineering-visual', `visual-${variant}`]} aria-hidden="true">
  <svg viewBox="0 0 600 420" fill="none" xmlns="http://www.w3.org/2000/svg">
    <g class="diagram-grid" stroke="currentColor" stroke-width="0.5">
      {Array.from({ length: 16 }, (_, i) => <path d={`M${i * 40} 0V420`} />)}
      {Array.from({ length: 11 }, (_, i) => <path d={`M0 ${i * 40}H600`} />)}
    </g>
    {drone ? <g stroke="currentColor" stroke-width="2">
      <path d="M190 105L410 315M410 105L190 315" stroke-width="16" opacity=".22" />
      <path d="M190 105L410 315M410 105L190 315" />
      {[ [190,105], [410,105], [190,315], [410,315] ].map(([x,y]) => <g><circle cx={x} cy={y} r="65" opacity=".3"/><ellipse cx={x} cy={y} rx="51" ry="14" transform={`rotate(-30 ${x} ${y})`}/><circle cx={x} cy={y} r="8"/></g>)}
      <rect x="263" y="166" width="74" height="88" rx="16" class="chip-fill"/><path d="M288 210L300 192L312 210M300 192V230"/>
    </g> : power ? <g stroke="currentColor" stroke-width="2">
      <rect x="105" y="88" width="390" height="245" rx="18" class="board-fill"/>
      <path d="M135 170H205V130H330V170H460M135 260H245V290H380V260H460" opacity=".5"/>
      <rect x="145" y="193" width="80" height="44" rx="6" class="chip-fill"/>
      <rect x="270" y="180" width="65" height="65" rx="7" class="chip-fill"/>
      {[0,1,2,3,4].map(i => <path d={`M${276+i*13} 173V160M${276+i*13} 252V265`} />)}
      <circle cx="403" cy="218" r="36"/><circle cx="403" cy="218" r="24" opacity=".4"/>
      <path d="M165 213H182L177 223H195"/><path d="M225 215H270M335 215H367"/>
      <text x="143" y="115">DIGITAL POWER / STM32G4</text>
    </g> : <g stroke="currentColor">
      <g opacity=".45" stroke-width="1.5">
        <path d="M0 128H143L209 194M0 292H158L218 232M600 112H447L382 178M600 310H450L387 246M243 0V98L274 130M347 420V328L323 290"/>
        <path d="M0 150H127L183 207M600 134H465L405 194M0 315H171L227 258M600 332H430L376 278"/>
        <circle cx="143" cy="128" r="4"/><circle cx="447" cy="112" r="4"/><circle cx="450" cy="310" r="4"/>
      </g>
      <g transform="translate(300 212) rotate(-30) skewX(16)">
        <rect x="-127" y="-112" width="254" height="254" rx="20" class="board-fill" stroke-width="1.5"/>
        <rect x="-112" y="-115" width="224" height="224" rx="15" class="board-fill" stroke-width="1.5"/>
        {Array.from({ length: 9 }, (_, i) => <g stroke-width="5" opacity=".55"><path d={`M${-64+i*16} -96V-75M${-64+i*16} 72V94M-96 ${-64+i*16}H-75M73 ${-64+i*16}H94`}/></g>)}
        <rect x="-73" y="-73" width="146" height="146" rx="10" class="chip-fill" stroke-width="2"/>
        <rect x="-60" y="-60" width="120" height="120" rx="6" opacity=".35"/>
        <path d="M-25 -28H11C37 -28 37 0 11 0H-25V-28ZM-25 0H15C43 0 43 29 15 29H-25V0Z" stroke-width="5"/>
        <circle cx="-49" cy="48" r="3" fill="currentColor"/>
      </g>
      <path class="signal-line" d="M37 350H69L83 350Q103 306 123 350T163 350T203 350T243 350H277" stroke-width="2"/>
      <text x="39" y="385">SIGNAL → CONTROL → SYSTEM</text>
      <text x="414" y="65">BITFORGE / LAB</text>
    </g>}
  </svg>
</div>
